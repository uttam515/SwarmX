{
  "name": "swarmx-vscode",
  "displayName": "SwarmX Distributed Runtime",
  "description": "Developer-facing distributed execution runtime for VS Code",
  "version": "0.1.0",
  "publisher": "swarmx",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "SwarmX Distributed Runtime",
      "properties": {
        "swarmx.enableWorkspaceIntegration": {
          "type": "boolean",
          "default": true,
          "description": "Enable transparent PYTHONPATH environment injection for automatic zero-import execution in this workspace."
        },
        "swarmx.forceSwarmDemoMode": {
          "type": "boolean",
          "default": false,
          "description": "DEMO MODE ONLY: Forces distributed execution to an eligible remote worker regardless of cost model speedup."
        },
        "swarmx.enableSimulationMode": {
          "type": "boolean",
          "default": false,
          "description": "DEVELOPMENT SIMULATION ONLY: Enables an isolated virtual Apple Silicon worker for testing without physical Mac #2."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swarmx-sidebar",
          "title": "SwarmX",
          "icon": "$(server-process)"
        }
      ]
    },
    "views": {
      "swarmx-sidebar": [
        {
          "type": "webview",
          "id": "swarmx.dashboardView",
          "name": "SwarmX Control Center"
        },
        {
          "id": "swarmx.workersView",
          "name": "Connected Swarm Workers"
        },
        {
          "id": "swarmx.discoveredView",
          "name": "Discovered Nearby Devices"
        },
        {
          "id": "swarmx.tasksView",
          "name": "Swarm Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "swarmx.refresh",
        "title": "SwarmX: Refresh Cluster State",
        "icon": "$(refresh)"
      },
      {
        "command": "swarmx.enableWorkspace",
        "title": "SwarmX: Enable Workspace Integration"
      },
      {
        "command": "swarmx.disableWorkspace",
        "title": "SwarmX: Disable Workspace Integration"
      },
      {
        "command": "swarmx.toggleForceSwarmDemo",
        "title": "SwarmX: Toggle Force Swarm (Demo Mode)"
      },
      {
        "command": "swarmx.toggleSimulation",
        "title": "SwarmX: Toggle Development Simulation Mode"
      },
      {
        "command": "swarmx.enableSimulation",
        "title": "SwarmX: Enable Development Simulation Mode"
      },
      {
        "command": "swarmx.disableSimulation",
        "title": "SwarmX: Disable Development Simulation Mode"
      },
      {
        "command": "swarmx.viewLogs",
        "title": "SwarmX: View Host Daemon Logs",
        "icon": "$(output)"
      },
      {
        "command": "swarmx.connectWorker",
        "title": "Connect / Pair Worker",
        "icon": "$(plug)"
      },
      {
        "command": "swarmx.revokeWorker",
        "title": "Revoke Worker Trust",
        "icon": "$(trash)"
      },
      {
        "command": "swarmx.toggleSwarm",
        "title": "Toggle Swarm Distributed Execution",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "swarmx.refresh",
          "when": "view == swarmx.dashboardView || view == swarmx.workersView",
          "group": "navigation"
        },
        {
          "command": "swarmx.viewLogs",
          "when": "view == swarmx.dashboardView",
          "group": "navigation"
        },
        {
          "command": "swarmx.toggleSwarm",
          "when": "view == swarmx.workersView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "swarmx.connectWorker",
          "when": "view == swarmx.discoveredView",
          "group": "inline"
        },
        {
          "command": "swarmx.revokeWorker",
          "when": "view == swarmx.workersView",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha --require ts-node/register --timeout 10000 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.80.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
